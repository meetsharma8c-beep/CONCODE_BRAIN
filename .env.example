# Authentication for the CONCODE API itself.
CONCODE_API_KEY=replace-with-a-separate-client-api-key

# Run the bundled model on this device. This is the default.
CONCODE_INFERENCE_BACKEND=local

# Optional: replace the local model with your own remote GPU server.
# CONCODE_INFERENCE_BACKEND=remote
# CONCODE_REMOTE_LLM_BASE_URL=https://llm.example.com/v1
# CONCODE_REMOTE_LLM_MODEL=concode-coder
# CONCODE_REMOTE_LLM_API_KEY=replace-with-a-long-random-server-token
# CONCODE_REMOTE_LLM_TIMEOUT_SECONDS=120

# Restrict browser clients to your applications.
CONCODE_CORS_ORIGINS=https://app.example.com
