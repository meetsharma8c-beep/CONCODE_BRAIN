# Authentication for the CONCODE API itself.
CONCODE_API_KEY=replace-with-a-separate-client-api-key

# Run the bundled model on this device. This is the default.
CONCODE_INFERENCE_BACKEND=local

# Optional: replace the local model with your own remote GPU server.
# CONCODE_INFERENCE_BACKEND=remote
# CONCODE_REMOTE_LLM_BASE_URL=https://llm.example.com/v1
# CONCODE_REMOTE_LLM_MODEL=concode-coder
# CONCODE_REMOTE_LLM_API_KEY=replace-with-a-long-random-server-token
# CONCODE_REMOTE_LLM_TIMEOUT_SECONDS=120

# Restrict browser clients to your applications.
CONCODE_CORS_ORIGINS=https://app.example.com

# ── CONCODE v4.0 APEX: Hybrid Frontier Sparse MoE Mesh (480B - 1T+ Params) ──
# Attach a single Frontier Sparse MoE endpoint (Kimi-K2 1T MoE, DeepSeek-R1 671B, Qwen3-Coder 480B):
# CONCODE_FRONTIER_URL=https://api.your-moe-provider.com/v1
# CONCODE_FRONTIER_MODEL=moonshotai/Kimi-K2-Instruct
# CONCODE_FRONTIER_API_KEY=replace-with-provider-token
# CONCODE_FRONTIER_PARAMS_B=1000
# CONCODE_FRONTIER_ACTIVE_PARAMS_B=32
#
# Or attach MULTIPLE Frontier Sparse MoE nodes for parallel Mixture-of-Agents (MoA) cross-verification:
# CONCODE_FRONTIER_NODES=[{"node_id":"kimi_1t","base_url":"https://.../v1","model":"moonshotai/Kimi-K2-Instruct","api_key":"...","role":"architect","total_params_b":1000,"active_params_b":32},{"node_id":"deepseek_r1","base_url":"https://.../v1","model":"deepseek-ai/DeepSeek-R1","api_key":"...","role":"verifier","total_params_b":671,"active_params_b":37},{"node_id":"qwen3_coder_480b","base_url":"https://.../v1","model":"Qwen/Qwen3-Coder-480B-A35B-Instruct","api_key":"...","role":"coder","total_params_b":480,"active_params_b":35}]
