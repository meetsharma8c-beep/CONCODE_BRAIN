# Copy to .env and replace both values before starting.
CONCODE_DOMAIN=brain.example.com
CONCODE_API_KEY=

# Optional: path to persistent model files on the Docker host; default is ../../models.
# CONCODE_MODEL_HOST_DIR=/srv/concode/models

# Optional, comma-separated browser origins. Keep empty for server-to-server API calls.
# CONCODE_CORS_ORIGINS=https://app.example.com
